(ns virtual-keyboard.utils
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/services.dart" :as services]
   [clojure.string :as str]
   [ime-core.linguistics :as linguistics]
   [virtual-keyboard.keyboard-state :as state]))

;; 1. UI Size Calculation
(defn get-key-button-size
  "Calculates the appropriate dimensions for a keyboard key based on screen size."
  [ctx]
  (let [screen-width (-> m/MediaQuery (.of ctx) .-size .-width)
        screen-height (-> m/MediaQuery (.of ctx) .-size .-height)
        width (* screen-width (if (> screen-width 350) 0.084 0.082))
        height (* screen-height (if (> screen-height 800) 0.059 0.07))]
    [width height]))

;; 2. Key Display Resolution
(defn key-text
  "Resolves the correct text to display on a virtual key, 
   respecting shift state and explicit display overrides."
  [vkey]
  (cond
    (some? (:display vkey))
    (:display vkey)

    (and (:keyboard/is-shift-enabled @state/state)
         (some? (:caps-text vkey)))
    (:caps-text vkey)

    :else
    (:text vkey)))

;; 3. Cursor Context Extraction
(defn get-current-word
  "Extracts the word immediately preceding the cursor in the TextField.
   Delegates string analysis to the core linguistics engine."
  [^String text ^services/TextSelection selection]
  (if (str/blank? text)
    ""
    (let [back-count 30
          ;; Extract up to 'back-count' characters right before the cursor
          substr (subs text (max 0 (- (.-start selection) back-count)) (.-end selection))
          ;; Delegate to the core engine to find the exact boundary of the last word
          last-word (linguistics/get-last-word substr)]
      (if (empty? last-word)
        ""
        last-word))))