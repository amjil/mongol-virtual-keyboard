(ns virtual-keyboard.keyboard
  (:require
   ["package:flutter/material.dart" :as m]
   [cljd.flutter :as f]
   [virtual-keyboard.keyboard-builder :as builder]
   [virtual-keyboard.keyboard-candidates :as kb-candidates]
   [virtual-keyboard.keyboard-layouts :as layouts]
   [virtual-keyboard.keyboard-rows :as rows]
   [virtual-keyboard.keyboard-state :as state]
   [virtual-keyboard.input-control :as control]
   [virtual-keyboard.options :as options]))

(defn keyboard [{:keys [custom-fns]}]
  (f/widget
   :context ctx
   :get {:value-of [:info]}
   :let [mg-keys (builder/keyboard-layout-builder layouts/mg-layout custom-fns)
         en-keys (builder/keyboard-layout-builder layouts/en-layout custom-fns)
         en-special-keys (builder/keyboard-layout-builder layouts/en-special-layout custom-fns)
         en-other-special-keys (builder/keyboard-layout-builder layouts/en-other-special-layout custom-fns)
         mg-special-keys (builder/keyboard-layout-builder layouts/mg-special-layout custom-fns)
         mg-other-special-keys (builder/keyboard-layout-builder layouts/mg-other-special-layout custom-fns)

         theme (-> m/Theme (.of ctx))
         color-scheme (.-colorScheme theme)
         info (merge (options/system-style theme) info)
         bottom-inset (-> m/MediaQuery (.of ctx) .-padding .-bottom)]
   :bind {:info info}
   :watch [{layout-index :keyboard/layout-index
            is-special-enabled :keyboard/is-special-enabled
            is-other-special-enabled :keyboard/is-other-special-enabled}
           state/state
           visible control/visible]
   (m/Visibility
    .visible visible
    .child
    (m/TextFieldTapRegion
     .child
     (m/Container
      .decoration (m/BoxDecoration
                   .color (or (:keyboard/background-color info)
                              (.-surfaceVariant color-scheme))
                   .border (m/Border.
                            .top (m/BorderSide
                                  .color (or (:keyboard/top-border-color info)
                                             (-> m.Colors/black (.withOpacity 0.08)))
                                  .width 0.5)))
      .padding (.only m/EdgeInsets
                      .top 6.0
                      .bottom (if (pos? bottom-inset) bottom-inset 8.0))
      .child
      (rows/keyboard-rows
       (cond
         (not= layout-index 1)
         (cond
           (and is-special-enabled is-other-special-enabled) mg-other-special-keys
           is-special-enabled mg-special-keys
           :else mg-keys)

         :else
         (cond
           (and is-special-enabled is-other-special-enabled) en-other-special-keys
           is-special-enabled en-special-keys
           :else en-keys))))))))


(defn get-height [info]
  (options/keyboard-height info))

(defn candidates [style]
  (kb-candidates/candidates style))

(defn candidates-panel [style]
  (kb-candidates/candidates-panel style))

(defn toolbar [widget]
  (f/widget 
   :watch [visible control/visible]
   (m/Visibility
    .visible visible
    .child widget)))