(ns virtual-keyboard.keyboard-action
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["package:mongol_code/mongol_code.dart" :as code]
   ["package:vibration/vibration.dart" :as vibrate]
   [cljd.flutter :as f]
   [clojure.string :as str]
   [ime-core.fst-engine :as fst-engine]
   [ime-core.next-word :as next-word]
   [ime-core.linguistics :as linguistics]
   [virtual-keyboard.options :as options]
   [virtual-keyboard.input-control :as control]
   [virtual-keyboard.utils :as utils]
   [virtual-keyboard.keyboard-state :as state]))

;; Helper to determine whether to use remote API based on options
(defn use-remote? []
  (= (or (:keyboard/candidate-source options/keyboard-option)
         options/candidate-source-default)
     :remote-json))

(declare on-key-press
         action-key-container
         clear-candidates)

;; Bumped on clear / new query so in-flight next-word results cannot
;; refill the panel after Return splits a block.
(defonce ^:private !candidate-gen (atom 0))

(defn- action-label-style
  [info color]
  (m/TextStyle
   .color (or color (:keyboard/action-text-color info))
   .fontFamily (:keyboard/english-font-family info)
   .fontWeight (.w500 m/FontWeight)
   .fontSize (or (:keyboard/shift-click-font-size info) 16)
   .letterSpacing 0.2))

(defn- action-label
  [info label]
  (m/Text
   label
   .textAlign (.center m/TextAlign)
   .style (action-label-style info nil)))

(defn- action-icon
  [info icon]
  (m/Icon icon
          .size 22
          .color (:keyboard/action-text-color info)))

(defn action-widget [vkey items-count rows-count custom-fns]
  (f/widget
   :context ctx
   :get {:value-of [:info]}
   :watch [{shift? :keyboard/is-shift-enabled
            special? :keyboard/is-special-enabled
            other-special? :keyboard/is-other-special-enabled
            layout-index :keyboard/layout-index
            return-mode :keyboard/return-mode}
           state/state]
   :let [width (-> m/MediaQuery (.of ctx) .-size .-width)
         height (:keyboard/height info)
         key-height (/ height rows-count)
         key-base-width (/ width 10)
         pad (:keyboard/horizontal-key-padding info)
         w (fn [factor] (- (* factor key-base-width) (* 2 pad)))
         space-color (or (:keyboard/space-key-color info)
                         (:keyboard/key-container-color info))
         action-color (:keyboard/action-keys-container-color info)
         done? (= :single-line return-mode)]
   (m/Padding
    .padding
    (.symmetric
     m/EdgeInsets
     .horizontal pad
     .vertical 0))
   .child
   (condp = (:action vkey)
     :backspace
     (m/GestureDetector
      .onLongPress
      (fn [] nil)
      .onLongPressUp
      (fn [] (swap! state/state assoc :keyboard/long-press false))
      .child
      (action-key-container
       {:width (w 1.5)
        :height key-height
        :color action-color
        :child (action-icon info (.backspace_outlined m/Icons))} vkey custom-fns))

     :shift
     (action-key-container
      {:width (w 1.5)
       :height key-height
       :color (if shift?
                (:keyboard/key-container-color info)
                action-color)
       :child (action-icon info (.arrow_upward m/Icons))} vkey custom-fns)

     :return
     (action-key-container
      {:width (w 1.5)
       :height key-height
       :color (if done?
                (or (:keyboard/return-key-color info) action-color)
                action-color)
       :child
       (if done?
         (m/Text
          "done"
          .textAlign (.center m/TextAlign)
          .style (action-label-style info m.Colors/white))
         (action-icon info (.keyboard_return m/Icons)))} vkey custom-fns)

     :space
     (action-key-container
      {:width (w 5)
       :height key-height
       :color space-color
       :child (m/SizedBox)} vkey custom-fns)

     :special-characters
     (action-key-container
      {:width (w 1.25)
       :height key-height
       :color action-color
       :child (action-label info (if special? "ABC" "123"))} vkey custom-fns)

     :small-special-characters
     (action-key-container
      {:width (w 1.25)
       :height key-height
       :color action-color
       :child (action-label info (if special? "ABC" "123"))} vkey custom-fns)

     :suffix-candidates
     (action-key-container
      {:width (w 1)
       :height key-height
       :color action-color
       :child
       (mgl/MongolText
        "ᠳᠠᠭᠠᠪᠤᠷᠢ"
        .style (m/TextStyle
                .color (:keyboard/action-text-color info)
                .fontFamily (:keyboard/mongol-font-family info)
                .fontWeight (.w500 m/FontWeight)
                .fontSize (:keyboard/shift-click-font-size info)))} vkey custom-fns)

     :spacer-block
     (action-key-container
      {:width (w 4)
       :height key-height
       :color space-color
       :child (m/SizedBox)} vkey custom-fns)

     :small-spacer-block
     (action-key-container
      {:width (w 3)
       :height key-height
       :color space-color
       :child (m/SizedBox)} vkey custom-fns)

     :extra-small-spacer-block
     (action-key-container
      {:width (* key-base-width 1.5)
       :height key-height
       :color space-color
       :child (m/SizedBox)} vkey custom-fns)

     :other-special-characters
     (action-key-container
      {:width (w 1.5)
       :height key-height
       :color action-color
       :child (action-label info (if other-special? "123" "#+="))} vkey custom-fns)

     :abc
     (action-key-container
      {:width (w 1.25)
       :height key-height
       :color action-color
       :child (action-label info (nth (:keyboard/layout-names info) layout-index))} vkey custom-fns)

     :empty
     (m/Container
      .width
      (w 0.5)))))

(defn action-key-container
  [{width :width height :height child :child color :color}
   vkey custom-fns]
  (f/widget
   :get {:value-of [:info]}
   :let [radius (options/key-cap-radius info)
         fill (or color (:keyboard/action-keys-container-color info))]
   (m/Container
    .height height
    .width width
    .decoration (options/key-cap-decoration info fill)
    .child
    (m/Material
     .color m.Colors/transparent
     .borderRadius (.all m/BorderRadius (.circular m/Radius radius))
     .child
     (m/InkWell
      .customBorder (m/RoundedRectangleBorder
                     .borderRadius (.all m/BorderRadius (.circular m/Radius radius)))
      .splashColor (-> m.Colors/black (.withOpacity 0.06))
      .highlightColor (-> m.Colors/black (.withOpacity 0.05))
      .onTap #(on-key-press vkey custom-fns)
      .child (m/Center .child child))))))

(defn ^:async on-key-press
  [vkey custom-fns]
  (when (true? (:keyboard/is-vibrate-on @state/state))
    (let [has-vibrate (await (.hasVibrator vibrate/Vibration))]
      (when (true? has-vibrate)
        (.vibrate vibrate/Vibration .duration (:keyboard/vibrate-duration @state/state)))))
  (condp = (:key-type vkey)
    :string
    (let [new-str (cond
                    (and (:keyboard/is-shift-enabled @state/state)
                         (some? (:caps-text vkey)))
                    (:caps-text vkey)

                    :else
                    (:text vkey))]
      (control/insert-text new-str)
      (when-let [editing-val @control/editing-value]
        (let [last-word (utils/get-current-word (.-text editing-val)
                                                (.-selection editing-val))
              gen (swap! !candidate-gen inc)
              candidates (->> (await (fst-engine/get-candidates-async last-word {:use-remote? (use-remote?)}))
                              (remove #(str/starts-with? % (str (char code/Mongol.mvs))))
                              vec)]
          (when (= gen @!candidate-gen)
            (swap! state/state assoc :keyboard/candidates-list candidates)))))

    :action
    (condp = (:action vkey)
      :backspace
      (if-let [custom-backspace (:on-backspace custom-fns)]
        (custom-backspace)
        (do
         (control/delete-last-word)
         (clear-candidates)))

      :return
      (do
        (clear-candidates)
        (if-let [custom-fn (:on-return custom-fns)]
          (custom-fn)
          (if (= :single-line (:keyboard/return-mode @state/state))
            (let [callback (:keyboard/return-callback @state/state)]
              (when-not (nil? callback)
                (callback)))
            (control/insert-text "\n"))))

      :space
      (do
        (control/insert-text " ")
        (clear-candidates))

      :spacer-block
      (do
        (control/insert-text " ")
        (clear-candidates))

      :small-spacer-block
      (do
        (control/insert-text " ")
        (clear-candidates))

      :shift
      (swap! state/state assoc :keyboard/is-shift-enabled (not (:keyboard/is-shift-enabled @state/state)))

      :abc
      (let [layout-index (get @state/state :keyboard/layout-index)]
        (swap! state/state assoc :keyboard/layout-index (mod (inc layout-index) (count (:keyboard/layout-names options/keyboard-option))))
        (swap! state/state assoc :keyboard/is-special-enabled false)
        (swap! state/state assoc :keyboard/is-other-special-enabled false))

      :special-characters
      (swap! state/state assoc :keyboard/is-special-enabled (not (:keyboard/is-special-enabled @state/state)))

      :other-special-characters
      (swap! state/state assoc :keyboard/is-other-special-enabled (not (:keyboard/is-other-special-enabled @state/state)))

      :suffix-candidates
      (when-let [val @control/editing-value]
        (let [text (.-text val)
              sel (.-selection val)
              start (max 0 (.-start sel))
              back-count 30
              text-before-cursor (subs text (max 0 (- start back-count)) start)
              candidates (linguistics/get-suffix-candidates text-before-cursor)]
          (swap! state/state assoc :keyboard/candidates-list candidates)))
      nil)
    nil))

(defn ^:async on-candidates-clicked
  [text]
  (let [text-with-space (str text " ")]
    (cond 
      ;; Check against linguistics core suffixes
      (some #{text} linguistics/all-suffixes)
      (do 
        (control/delete-text)
        (control/insert-text text-with-space))
      
      (str/starts-with? text (str (char code/Mongol.mvs)))
      (do 
        (control/delete-text)
        (control/insert-text text-with-space))
    
      :else
      (control/replace-word text-with-space)))

  ;; Fetch Next-Word predictions purely through the unified Core Engine
  (let [gen (swap! !candidate-gen inc)
        next-words (await (next-word/get-predictions-async text {:use-remote? (use-remote?)}))]
    (when (= gen @!candidate-gen)
      (if (empty? next-words)
        (swap! state/state assoc :keyboard/candidates-list [])
        (swap! state/state assoc :keyboard/candidates-list (vec next-words))))))

(defn clear-candidates []
  (swap! !candidate-gen inc)
  (swap! state/state assoc :keyboard/candidates-list []))